{
  "name": "unjobbed",
  "version": "1.1.0",
  "description": "Typed, multi-board job search & intelligence pipeline. Scrapes LinkedIn, Indeed, Glassdoor, Wellfound, Dice, and direct ATS boards (Greenhouse, Lever, Ashby, Workday).",
  "type": "module",
  "license": "MIT",
  "author": "LuxDevNet",
  "repository": {
    "type": "git",
    "url": "https://github.com/LuxDevNet/jobhound.git"
  },
  "keywords": [
    "job-scraper",
    "job-search",
    "crawlee",
    "apify",
    "playwright",
    "greenhouse",
    "lever",
    "ashby",
    "indeed",
    "linkedin",
    "ats"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "bin": {
    "unjobbed": "./src/cli.ts"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "searches",
    "README.md",
    ".actor"
  ],
  "scripts": {
    "jobs": "tsx src/cli.ts",
    "ui": "tsx src/cli.ts ui",
    "run:sd": "tsx src/cli.ts run san-diego-120k",
    "dry": "tsx src/cli.ts run san-diego-120k --dry-run",
    "sources": "tsx src/cli.ts sources",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "apify": "^3.7.2",
    "apify-client": "^2.25.0",
    "cheerio": "^1.2.0",
    "crawlee": "^3.18.1",
    "p-limit": "^7.3.3",
    "playwright": "^1.63.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
